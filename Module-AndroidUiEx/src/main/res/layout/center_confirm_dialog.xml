<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.au.module_androidui.widget.BgBuildLinearLayout
        android:id="@+id/dialogHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="20dp"
        app:backgroundNormal="@color/windowDialogBackground"
        app:cornerRadius="32dp">

        <com.au.module_androidui.widget.CustomFontText
            android:id="@+id/titleTv"
            style="@style/StyleAuBTextTitle2"
            app:customFontMode="mid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2" />

        <com.au.module_androidui.widget.CustomFontText
            android:id="@+id/descTv"
            style="@style/StyleAuTextThin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.au.module_androidui.widget.CustomButton
                android:id="@+id/cancelBtn"
                style="@style/StyleAuTextNormalMid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                app:backgroundNormal="@color/color_normal_block"
                app:cornerRadius="22dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <com.au.module_androidui.widget.CustomButton
                android:id="@+id/confirmBtn"
                style="@style/StyleAuTextNormalMid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                app:backgroundNormal="@color/color_normal_block"
                app:cornerRadius="22dp" />
        </LinearLayout>
    </com.au.module_androidui.widget.BgBuildLinearLayout>
</LinearLayout>
