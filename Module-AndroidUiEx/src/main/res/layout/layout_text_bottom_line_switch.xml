<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:parentTag="com.au.module_androidui.widget.BgBuildConstraintLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="36dp"
    tools:clipChildren="false"
    tools:clipToPadding="false"
    tools:padding="4dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/centerGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <FrameLayout
        android:id="@+id/selectBgView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/centerGuideline"
        android:layout_height="36dp"
        android:layout_width="0dp">
        <com.au.module_androidui.widget.BgBuildView
            android:id="@+id/selectBgViewReal"
            app:cornerRadius="1dp"
            app:backgroundNormal="#404040"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:layout_height="2dp"
            android:layout_width="20dp"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/leftLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/centerGuideline"
        android:orientation="horizontal"
        android:gravity="center">

        <com.au.module_androidui.widget.CustomFontText
            android:id="@+id/leftTv"
            style="@style/StyleAuTextNormalMid"
            android:paddingHorizontal="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            tools:text="For you" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rightLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/centerGuideline"
        android:orientation="horizontal"
        android:gravity="center">

        <com.au.module_androidui.widget.CustomFontText
            android:id="@+id/rightTv"
            style="@style/StyleAuTextNormalDesc"
            app:customFontMode="mid"
            android:paddingHorizontal="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            tools:text="Activities" />
    </LinearLayout>
</merge>