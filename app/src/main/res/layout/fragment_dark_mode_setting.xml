<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/languageBtn"
        style="@style/StyleAuTextNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ui_padding_edge"
        android:text="@string/language" />

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/languageTv"
        style="@style/StyleAuTextSmallDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/ui_padding_edge" />

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/nightModeBtn"
        style="@style/StyleAuTextNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="@dimen/ui_padding_edge"
        android:text="@string/dark_mode" />

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/nightModeTv"
        style="@style/StyleAuTextSmallDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/ui_padding_edge" />
</LinearLayout>
