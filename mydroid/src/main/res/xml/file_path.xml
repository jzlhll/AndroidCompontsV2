<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 某个目录下的所有子文件夹和文件都可以分享。 -->
    <external-cache-path
        name="external_cache_path"
        path="./logShare" />

    <cache-path
        name="cache_path"
        path="./logShare" />

    <files-path
        name="files_path"
        path="./shared" />

    <cache-path
        name="cache_path"
        path="./shared" />

    <!-- client 下载文件落盘到 goodCacheDir/shared/nanoMerged，与 host 接收文件目录一致；
         显式声明子目录避免对 cache-path 递归行为的依赖 -->
    <cache-path
        name="nano_merged"
        path="./shared/nanoMerged" />

    <external-files-path
        name="external_file_path"
        path="./shared" />

    <external-cache-path
        name="external_cache_path"
        path="./shared" />
</paths>