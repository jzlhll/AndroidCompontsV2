<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground"
    android:clickable="true"
    android:focusable="false">

    <FrameLayout
        android:id="@+id/historyToolbarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/logic_receiver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.au.module_androidui.widget.CustomToolbar
            android:id="@+id/historyToolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:navigationContentDescription="@string/transfer_back"
            app:navigationIcon="@drawable/icon_back"
            app:navigationIconTint="@color/white"
            app:title="@string/export_history"
            app:titleCentered="true"
            app:titleTextColor="@color/white" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/historyScrollLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/historyToolbarLayout">

        <com.au.module_androidui.widget.CustomFontText
            android:id="@+id/historyTv"
            style="@style/StyleAuTextNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/ui_padding_edge"
            android:paddingVertical="12dp"
            android:text="@string/keep_recent_records" />
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
