<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true">

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/videoBlurTarget"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:surface_type="texture_view"
            app:resize_mode="fit"
            app:buffered_color="@color/transfer_preview_track"
            app:unplayed_color="@color/transfer_preview_track"
            app:show_buffering="when_playing"
            app:show_timeout="2000"
            app:auto_show="false"
            app:animation_enabled="false"
            app:hide_on_touch="true"
            app:show_next_button="false"
            app:show_previous_button="false" />
    </eightbitlab.com.blurview.BlurTarget>

    <FrameLayout
        android:id="@+id/mediaHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp">

        <com.au.module_androidui.widget.CustomFontText
            android:id="@+id/videoTimeTv"
            style="@style/StyleWebTransferAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/previewSettingsBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/exo_styled_controls_settings"
            android:contentDescription="@string/exo_controls_settings_description"
            android:visibility="gone"
            app:tint="@color/white" />

        <com.allan.mydroid.views.send.PreviewControlsLayout
            android:id="@+id/playbackControlsHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/playbackDragHandleImg"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:scaleType="center"
                    android:src="@drawable/ic_preview_drag_handle"
                    android:contentDescription="@string/preview_drag_controls" />

                <FrameLayout
                    android:id="@+id/playbackButtonsHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.allan.mydroid.views.send.PreviewControlsLayout>

        <com.allan.mydroid.views.send.PreviewControlsLayout
            android:id="@+id/frameControlsHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="72dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/frameDragHandleImg"
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:scaleType="center"
                    android:src="@drawable/ic_preview_drag_handle"
                    android:contentDescription="@string/preview_drag_controls" />

                <com.au.module_androidui.widget.CustomButton
                    android:id="@+id/backTenFramesBtn"
                    style="@style/StylePreviewFrameButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="@drawable/ic_frame_back"
                    android:contentDescription="@string/preview_back_ten_frames_drag" />

                <com.au.module_androidui.widget.CustomButton
                    android:id="@+id/stepFrameBtn"
                    style="@style/StylePreviewFrameButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="@drawable/ic_frame_forward"
                    android:contentDescription="@string/preview_next_frame_drag" />

                <com.au.module_androidui.widget.CustomButton
                    android:id="@+id/nextTenFramesBtn"
                    style="@style/StylePreviewFrameButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="0dp"
                    android:foreground="@drawable/ic_frame_forward_ten"
                    android:contentDescription="@string/preview_next_ten_frames_drag" />
            </LinearLayout>
        </com.allan.mydroid.views.send.PreviewControlsLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/closePreviewBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_preview"
            android:contentDescription="@string/preview_close"
            app:tint="@color/white" />
    </FrameLayout>
</FrameLayout>
