<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/descTitle"
        android:background="@color/logic_receiver"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

    <com.au.module_androidui.widget.CustomToolbar
        app:title="@string/file_receive"
        app:titleCentered="true"
        android:id="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="#ffffff"
        app:navigationIcon="@drawable/icon_back"
        app:navigationIconTint="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/descTitle"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        style="@style/StyleWebTransferDescription"
        tools:text="不退出，不熄屏"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingHorizontal="@dimen/ui_padding_edge"
        android:paddingVertical="6dp"
        android:maxLines="2" />

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/title"
        style="@style/StyleAuTextThin"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/descTitle"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/ui_padding_edge"
        android:maxLines="2" />

    <com.au.module_androidui.widget.ShineView
        android:id="@+id/adHost"
        android:background="@color/color_normal_block"
        android:layout_marginVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_width="0dp"
        android:layout_height="@dimen/web_transfer_placeholder_height"
        android:layout_marginHorizontal="@dimen/ui_padding_edge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/bottomHostId"
        android:name="com.allan.mydroid.views.receiver.ReceiveFromH5FileListFragment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
