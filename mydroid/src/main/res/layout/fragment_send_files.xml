<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/descTitle"
        android:background="@color/logic_send"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>

    <com.au.module_androidui.widget.CustomToolbar
        app:title="@string/app_file_send"
        android:id="@+id/toolbar"
        app:titleCentered="true"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="#ffffff"
        app:navigationIcon="@drawable/icon_back"
        app:navigationIconTint="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/descTitle"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        style="@style/StyleWebTransferDescription"
        tools:text="不退出，不熄屏"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingHorizontal="@dimen/ui_padding_edge"
        android:paddingVertical="6dp"
        android:maxLines="2" />

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/title"
        style="@style/StyleAuTextThin"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/descTitle"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/ui_padding_edge"
        android:maxLines="2" />

    <LinearLayout
        android:id="@+id/clientsHost"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_padding_edge"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv"
        android:layout_marginTop="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clientsHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <View
        android:id="@+id/blurView"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/descTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/transfer_preview_overlay"
        android:clickable="true"
        android:focusable="true" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bigImage"
        android:visibility="gone"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/descTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:layout_marginHorizontal="@dimen/ui_padding_edge" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iconPlay"
        android:visibility="gone"
        android:src="@drawable/ic_play_in_big"
        app:layout_constraintStart_toStartOf="@id/bigImage"
        app:layout_constraintEnd_toEndOf="@id/bigImage"
        app:layout_constraintTop_toTopOf="@id/bigImage"
        app:layout_constraintBottom_toBottomOf="@id/bigImage"
        android:tint="@color/white"
        android:layout_width="40dp"
        android:layout_height="40dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
