<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/text_chat_surface">

    <com.au.module_androidui.widget.CustomToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/icon_back"
        app:navigationIconTint="@color/text_chat_text"
        app:title="@string/text_chat_room"
        app:titleCentered="true"
        app:titleTextColor="@color/text_chat_text" />

    <com.au.module_androidui.widget.CustomFontText
        android:id="@+id/hostAddressTv"
        style="@style/StyleTextChatClient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:gravity="center"
        android:paddingHorizontal="@dimen/ui_padding_edge"
        android:paddingVertical="6dp"
        android:maxLines="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:text="172.16.1.18:15555" />

    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTarget"
        android:background="@color/text_chat_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/inputHost"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hostAddressTv">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRcv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            tools:listitem="@layout/holder_text_chat_message" />
    </eightbitlab.com.blurview.BlurTarget>

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/clientsBlurView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/clientsHost"
        app:layout_constraintEnd_toEndOf="@id/clientsHost"
        app:layout_constraintStart_toStartOf="@id/clientsHost"
        app:layout_constraintTop_toTopOf="@id/clientsHost" />

    <LinearLayout
        android:id="@+id/clientsHost"
        android:layout_width="0dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/hostAddressTv"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:id="@+id/inputHost"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/text_chat_surface"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <com.au.module_androidui.widget.CustomEditText
                android:id="@+id/inputEdit"
                style="@style/StyleTextChatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|start"
                android:hint="@string/text_chat_input_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxHeight="120dp"
                android:minHeight="44dp"
                android:overScrollMode="ifContentScrolls"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:scrollbars="vertical"
                tools:text="你好，先只做一个本地文本聊天界面" />

            <com.au.module_androidui.widget.CustomButton
                android:id="@+id/sendBtn"
                style="@style/StyleTextChatSend"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:text="@string/send"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
